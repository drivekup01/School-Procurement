rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function p() { return /databases/(default)/documents/procurement_users/$(request.auth.uid); }
    function member() { return signedIn() && firestore.exists(p()); }
    function profile() { return firestore.get(p()).data; }
    function isAdmin() { return member() && profile().role == 'admin'; }
    function permitted(projectId,docId) {
      return member() && firestore.exists(/databases/(default)/documents/procurement_documents/$(docId)) &&
        (isAdmin() || profile().departmentId ==
        firestore.get(/databases/(default)/documents/procurement_documents/$(docId)).data.departmentId) &&
        firestore.get(/databases/(default)/documents/procurement_documents/$(docId)).data.projectId == projectId;
    }
    // Official template: read-only to authenticated procurement members.
    // Upload/replacement must be done by a trusted administrator via Firebase Console or Admin SDK.
    // One-time official DOCX master installation, accessible to authenticated school staff.
    // Admin may replace a department's current template after confirming in the UI.
    // Verified PDF master: signed-in members may view, only Admin may install/replace.
    // Private school font for PDF overlays; members may read, Admin alone may install.
    match /procurement/fonts/THSarabunIT9.ttf {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType == 'application/octet-stream';
      allow delete: if false;
    }
    match /procurement/templates/departments/{department}/source.pdf {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }
    match /procurement/templates/departments/{department}/source.docx {
      // Template viewing requires login but not a secondary Firestore lookup.
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
      allow delete: if false;
    }
    match /procurement/templates/first-set/source.pdf {
      allow read: if member();
      allow write: if false;
    }
    match /procurement/projects/{projectId}/files/{docId} {
      allow read: if member() && firestore.exists(/databases/(default)/documents/procurement_documents/$(docId)) &&
        firestore.get(/databases/(default)/documents/procurement_documents/$(docId)).data.projectId == projectId;
      allow create: if permitted(projectId,docId) &&
        firestore.get(/databases/(default)/documents/procurement_documents/$(docId)).data.status == 'uploading' &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
  }
}